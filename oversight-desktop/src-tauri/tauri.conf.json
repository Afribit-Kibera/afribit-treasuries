{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Afribit Oversight",
  "mainBinaryName": "Afribit Oversight",
  "version": "0.2.0",
  "identifier": "africa.afribit.oversight",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5178"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; frame-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Afribit Africa",
    "copyright": "Afribit Africa",
    "category": "Finance",
    "shortDescription": "Approve clan payouts for your community",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "resources": {
      "../build/python/": "python/"
    },
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
