# Dedicated read-only backup role for ONLY the Clans PostgreSQL database.
# Install as /etc/afribit-clans/backup.env with root-only permissions; do not use backend.env.
CLANS_DATABASE_URL=postgresql+psycopg://afribit_clans_backup@127.0.0.1:5432/afribit_clans
# Copy ONLY the RSA >=3072-bit public key here. Keep its private key offline.
CLANS_BACKUP_PUBLIC_KEY_FILE=/etc/afribit-clans/backup-recipient.pub.pem
# Configure a verified SSH host key and dedicated upload-only identity first.
CLANS_BACKUP_SSH_TARGET=backups@backup.example:/clans/archives