# Set process environment variables; the app does not auto-load a secrets file.
CLANS_DATABASE_URL=sqlite+pysqlite:///.local/clans-demo.db
CLANS_DEMO_AUTH_ENABLED=false
CLANS_SIMULATION_ENABLED=false
# No live payment execution exists in this milestone.
CLANS_BTCPAY_URL=https://pay.insats.org
# Leave credentials unset until there is a dedicated scoped Clans integration.
CLANS_BTCPAY_API_KEY=
CLANS_BTCPAY_STORE_ID=
# Clan multisig wallets (off by default). Oversight keys are the oversight laptops'
# PUBLIC keys, comma separated, 1 to 3. Any one can approve. Test networks use
# "[fingerprint/87'/1'/0']tpub..."; Bitcoin mainnet uses "[fingerprint/87'/0'/0']xpub...".
CLANS_CLAN_WALLETS_ENABLED=false
# bitcoin (mainnet, real money) by default. Use signet or testnet4 to try it out.
CLANS_CLAN_WALLET_NETWORK=bitcoin
CLANS_CLAN_WALLET_OVERSIGHT_KEYS=
CLANS_CLAN_WALLET_RECOVERY_BLOCKS=26280
# Confirmations before a payment counts (1 to 12).
CLANS_CLAN_WALLET_CONFIRMATIONS=3
# Esplora APIs, comma separated, tried in order. Empty: mempool.space, then blockstream.info.
# Put your own first, e.g. http://umbrel.local:3006/api,https://mempool.space/api
CLANS_CLAN_WALLET_ESPLORA_URL=
# A wallet with no new block and no new activity is read this often (30 to 3600).
CLANS_CLAN_WALLET_IDLE_READ_SECONDS=300
